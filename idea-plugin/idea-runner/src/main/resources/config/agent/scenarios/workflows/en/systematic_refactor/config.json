{
  "verifiers": [
    {
      "type": "NoFileErrorsVerifier",
      "path": "core/src/main/java/io/aiven/klaw/service/ExportImportDataService.java",
      "languages": ["java"]
    },
    {
      "type": "YesChangesVerifier",
      "target_files": [
        "core/src/main/java/io/aiven/klaw/service/ExportImportDataService.java"
      ]
    },
    {
      "type": "RunBuildSystemTaskVerifier",
      "build_system_name": "maven",
      "tasks": ["-DskipTests=true", "compile"],
      "reg_exp_pattern": "\\[INFO\\] BUILD SUCCESS"
    },
    {
      "type": "JavaRunTestsVerifier",
      "build_system_name": "maven",
      "command": ["mvn", "-pl", "core", "-am", "test"],
      "test_pattern": "ExportImportDataServiceTest"
    }
  ],
  "project_path": "klaw",
  "opened_files": [],
  "language": "English",
  "fixed_fst_user_message": true,
  "tags": ["workflows", "all"],
  "mcp_servers": [
    {
        "name": "github",
        "url": "https://api.githubcopilot.com/mcp",
        "headers": {
          "Authorization": "Bearer $GITHUB_TOKEN$"
        },
        "type": "http"
    }
  ],
  "preprocessors": [
    {
      "type": "RunBuildSystemTaskPreprocessor",
      "build_system_name": "maven",
      "tasks": ["-DskipTests=true", "install", "-fpom.xml"]
    }
  ]
}
