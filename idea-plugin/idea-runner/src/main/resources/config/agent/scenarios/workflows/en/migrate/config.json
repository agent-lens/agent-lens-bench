{
  "verifiers": [
    {
      "type": "RunBuildSystemTaskVerifier",
      "build_system_name": "maven",
      "tasks": ["-DskipTests=true", "compile"],
      "reg_exp_pattern": "\\[INFO\\] BUILD SUCCESS"
    },
    {
      "type": "JavaFileRegExpCountVerifier",
      "reg_exp_pattern": "<groupId>org.springframework.boot</groupId>\\s+<artifactId>spring-boot-starter-parent</artifactId>\\s+<version>3.5.6</version>",
      "search_in": "pom.xml",
      "strict_count": true,
      "num_expected": 1,
      "uncommented_only": false
    },
    {
      "type": "JavaRunTestsVerifier",
      "build_system_name": "maven",
      "command": ["mvn", "-pl", "core", "-am", "test"]
    },
    {
      "type": "JavaRunTestsVerifier",
      "build_system_name": "maven",
      "command": ["mvn", "-pl", "cluster-api", "-am", "test"]
    }
  ],
  "project_path": "klaw",
  "opened_files": [],
  "language": "English",
  "fixed_fst_user_message": true,
  "tags": ["workflows", "all"],
  "mcp_servers": [
    {
        "name": "github",
        "url": "https://api.githubcopilot.com/mcp",
        "headers": {
          "Authorization": "Bearer $GITHUB_TOKEN$"
        },
        "type": "http"
    }
  ],
  "preprocessors": [
    {
      "type": "RunBuildSystemTaskPreprocessor",
      "build_system_name": "maven",
      "tasks": ["-DskipTests=true", "install", "-fpom.xml"]
    }
  ]
}
