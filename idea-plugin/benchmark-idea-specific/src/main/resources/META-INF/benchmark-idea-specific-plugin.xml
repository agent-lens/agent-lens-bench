<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <depends>org.jetbrains.kotlin</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>

    <depends>com.intellij.java</depends>

    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.gradle</depends>

    <actions>
        <action id="com.anonymous.benchmark.actions.RunAgentBenchmarkAction"
                class="com.anonymous.benchmark.actions.RunAgentBenchmarkAction"
                text="Run Agent Benchmark"
                description="Run agent simulation for selected scenarios">
            <keyboard-shortcut keymap="$default" first-keystroke="alt A"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.anonymous.benchmark.runner.agent.JavaAgentBenchHeadlessStartupActivity"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.anonymous.benchmark">
        <common.ideBuildSystem implementation="com.anonymous.benchmark.utils.buildSystem.IdeaBuildSystem"/>
        <serializationService
                implementation ="com.anonymous.benchmark.runner.agent.IdeaSpecificBenchmarkSerializationService"/>
    </extensions>

</idea-plugin>
